# ==========================================
# SMART LOGISTICS & ROUTE OPTIMIZATION PLATFORM
# Backend Environment Configuration Template
# ==========================================

APP_NAME="Smart Logistics & Route Optimization Platform"
APP_VERSION=1.0.0
APP_ENV=production
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:3000

# Security & Secrets (MUST be generated securely in production)
SECRET_KEY=generate-a-strong-random-secret-key-32-chars-minimum
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=smart_logistics
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_db_password_here@postgres:5432/smart_logistics

# Database Connection Pool
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Redis Cache & Telemetry Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI & Dynamic Decision Support
AI_ENABLED=True
AI_DELAY_THRESHOLD=0.75
AI_PRIORITY_THRESHOLD=80.0
AI_REOPTIMIZATION_THRESHOLD=5.0
FUEL_COST_PER_LITER=1.45
AVG_FUEL_CONSUMPTION_L_PER_100KM=12.5
